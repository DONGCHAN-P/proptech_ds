      "reading_normalized_start": 32,
      "alignment_basis": "provider_word_boundaries_with_explicit_display_reading_map",
      "wrapped_text": "가격과 생활권을\n함께 살펴보겠습니다.",
      "lexical_change": false
    },
    {
      "sentence_id": "P01-R17-V2-01",
      "text": "17위는 인천 연수구,",
