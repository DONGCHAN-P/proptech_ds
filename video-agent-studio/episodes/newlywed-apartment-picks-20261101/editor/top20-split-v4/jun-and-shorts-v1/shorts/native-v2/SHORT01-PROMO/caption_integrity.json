      "end_s": 26.38,
      "display_normalized_range": [
        0,
        17
      ],
      "reading_normalized_start": 0,
      "alignment_basis": "provider_word_boundaries_with_explicit_display_reading_map",
      "wrapped_text": "거래 중위값은 연수동\n3억3,150만원,",
      "lexical_change": false
    },
    {
      "sentence_id": "P01-R17-V2-05",
      "text": "송도동 7억4,000만원으로,",
      "start_s": 26.38,
