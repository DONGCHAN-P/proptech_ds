      ],
      "reading_normalized_start": 29,
      "alignment_basis": "provider_word_boundaries_with_explicit_display_reading_map",
      "wrapped_text": "두 생활권의 예산\n조건이 크게 갈립니다.",
      "lexical_change": false
    },
    {
      "sentence_id": "SHORTS-CTA-01",
      "text": "나머지 순위도 궁금하시다면 다른 순위",
