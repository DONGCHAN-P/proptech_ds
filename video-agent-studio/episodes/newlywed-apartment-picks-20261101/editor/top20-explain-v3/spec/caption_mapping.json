    {
      "scene_id": "S007",
      "start_s": 102.14285714285714,
      "end_s": 107.23214285714286,
      "text": "공원 안에는 옛 염전을 활용한 학습장도 있어 해안의 생태환경과 염전의 흔적을",
      "sentence_id": "S007-04"
    },
    {
