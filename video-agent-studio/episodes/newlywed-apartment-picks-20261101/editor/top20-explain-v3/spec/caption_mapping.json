  "cues": [
    {
      "scene_id": "O002",
      "start_s": 0.0,
      "end_s": 3.085714285714286,
      "text": "순위의 출처는 국가데이터처가 발표한 2024년 신혼부부통계입니다.",
      "sentence_id": "O002-01"
    },
    {
      "scene_id": "O002",
      "start_s": 3.085714285714286,
      "end_s": 5.115991471215352,
      "text": "2024년 11월 1일 거주지를 기준으로,",
      "sentence_id": "O002-02"
    },
    {
      "scene_id": "O002",
      "start_s": 5.115991471215352,
      "end_s": 8.47036247334755,
      "text": "혼인신고 후 5년이 지나지 않은 부부를 초혼과 재혼을 합쳐 쌍 단위로",
      "sentence_id": "O002-02"
    },
    {
      "scene_id": "O002",
      "start_s": 8.47036247334755,
      "end_s": 9.0,
      "text": "비교합니다.",
      "sentence_id": "O002-02"
    },
    {
      "scene_id": "O002",
      "start_s": 9.0,
      "end_s": 11.361516034985424,
      "text": "이후 입주와 이사로 거주 분포가 달라질 수 있어,",
      "sentence_id": "O002-06"
    },
    {
      "scene_id": "O002",
      "start_s": 11.361516034985424,
      "end_s": 13.285714285714286,
      "text": "당시의 분포를 출발점으로 살펴보겠습니다.",
      "sentence_id": "O002-06"
    },
    {
      "scene_id": "O002",
      "start_s": 13.285714285714286,
      "end_s": 16.423728813559322,
      "text": "가격은 2026년 5월부터 10월까지 계약된 아파트 매매 실거래를",
      "sentence_id": "O002-07A"
    },
    {
      "scene_id": "O002",
      "start_s": 16.423728813559322,
      "end_s": 18.428571428571427,
      "text": "2026년 11월 3일 조회한 자료입니다.",
      "sentence_id": "O002-07A"
    },
    {
      "scene_id": "O002",
      "start_s": 18.428571428571427,
      "end_s": 21.514285714285716,
      "text": "전용면적 83제곱미터 이상 85제곱미터 이하의 거래를 비교합니다.",
      "sentence_id": "O002-07B"
    },
    {
      "scene_id": "O002",
      "start_s": 21.514285714285716,
      "end_s": 23.345320197044337,
      "text": "10월 계약분은 신고가 진행 중이어서,",
      "sentence_id": "O002-07D"
    },
    {
      "scene_id": "O002",
      "start_s": 23.345320197044337,
      "end_s": 26.571428571428573,
      "text": "조회 뒤 추가 신고나 정정·해제에 따라 수치가 달라질 수 있습니다.",
      "sentence_id": "O002-07D"
    },
    {
      "scene_id": "O002",
      "start_s": 26.571428571428573,
      "end_s": 30.0,
      "text": "중위값은 거래금액을 낮은 순서대로 놓았을 때 가운데에 해당하는 값입니다.",
      "sentence_id": "O002-08"
    },
    {
      "scene_id": "S005",
      "start_s": 30.0,
      "end_s": 32.857142857142854,
      "text": "18위는 용인시 기흥구, 7,686쌍입니다.",
      "sentence_id": "S005-01"
    },
    {
      "scene_id": "S005",
      "start_s": 32.857142857142854,
      "end_s": 37.8419452887538,
      "text": "기흥구는 동백·흥덕의 대규모 택지개발 주거지와 기업·연구시설이 함께 자리한",
      "sentence_id": "S005-02"
    },
    {
      "scene_id": "S005",
      "start_s": 37.8419452887538,
      "end_s": 38.57142857142857,
      "text": "지역입니다.",
      "sentence_id": "S005-02"
    },
    {
      "scene_id": "S005",
      "start_s": 38.57142857142857,
      "end_s": 42.023809523809526,
      "text": "구성역은 GTX-A와 수인분당선이 만나는 거점입니다.",
