    },
    {
      "scene_id": "S005",
      "start_s": 42.023809523809526,
      "end_s": 45.06469979296067,
      "text": "동백과 구성역 주변은 서로 다른 생활권이므로,",
      "sentence_id": "S005-04"
    },
    {
      "scene_id": "S005",
      "start_s": 45.06469979296067,
      "end_s": 47.61904761904762,
      "text": "단지와 역 위치를 함께 살펴보겠습니다.",
