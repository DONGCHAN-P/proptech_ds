# 부동산 콘텐츠 파이프라인 — 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git에 올라가지 않는다.
#
#   cp .env.example .env     (PowerShell: Copy-Item .env.example .env)

# ── 데이터 수집 ────────────────────────────────────────
# 공공데이터포털 실거래가 API (H1)
TDATA_API_KEY=
# 공동주택 단지정보 API — 세대수·준공일 (T6b)
KAPT_SERVICE_KEY=
# 학교알리미 (인프라)
NEIS_API_KEY=
# VWorld — 지오코딩
VWORLD_API_KEY=
# VWorld 배경지도 타일 (web/). 도메인 등록 필요, 없으면 OSM 사용
VWORLD_MAP_KEY=

# ── LLM · 생성 ─────────────────────────────────────────
# Anthropic (H5) — 스레드/롱폼 텍스트 변환
ANTHROPIC_API_KEY=
# ElevenLabs (H6) — 최종 음성
ELEVENLABS_API_KEY=
# FAL (H7) — 썸네일 추상 배경
FAL_KEY=

# ── 발행 ───────────────────────────────────────────────
# Meta (H2) — Threads + Instagram
META_APP_ID=
META_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# Google (H4) — YouTube Data API
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ── 알림 ───────────────────────────────────────────────
# Telegram (H8) — 승인 게이트웨이 + 실패 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack (선택) — run_quality_check.py 가 사용
SLACK_WEBHOOK=
